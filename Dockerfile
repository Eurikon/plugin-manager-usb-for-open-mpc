ARG BUILD_BASE=arm32v7/gcc:11-bullseye
FROM ${BUILD_BASE} AS dependencies
RUN if [ -f /etc/apt/sources.list ]; then sed -i 's|http://|https://|g; s|https://deb.debian.org/debian-security|https://snapshot.debian.org/archive/debian-security/20260830T000000Z/|g' /etc/apt/sources.list; else sed -i 's|http://|https://|g' /etc/apt/sources.list.d/debian.sources; fi && apt-get -o Acquire::Check-Valid-Until=false update && apt-get install -y --no-install-recommends libdrm-dev libgbm-dev libegl1-mesa-dev libgles2-mesa-dev libudev-dev libfreetype6-dev libarchive-dev nlohmann-json3-dev fonts-dejavu-core ca-certificates e2fsprogs && rm -rf /var/lib/apt/lists/*
FROM dependencies AS runtime-build
RUN curl -fL https://www.libsdl.org/release/SDL2-2.30.12.tar.gz -o /tmp/sdl.tgz && mkdir /tmp/sdl && tar -xzf /tmp/sdl.tgz -C /tmp/sdl --strip-components=1 && cd /tmp/sdl && ./configure --prefix=/opt/sdl --disable-shared --enable-static --enable-video-kmsdrm --disable-video-x11 --disable-video-wayland --disable-audio --disable-haptic --disable-joystick --disable-sensor --disable-vulkan --disable-video-opengl --enable-video-opengles && make -j4 && make install && rm -rf /tmp/sdl /tmp/sdl.tgz
